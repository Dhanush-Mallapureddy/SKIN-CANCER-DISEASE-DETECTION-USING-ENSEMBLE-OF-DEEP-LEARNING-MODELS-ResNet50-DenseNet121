        "def find_best_weights(resnet, densenet, loader):\n",
        "\n",
        "    resnet.eval()\n",
        "    densenet.eval()\n",
        "\n",
        "    best_acc = 0\n",
        "    best_w = (0.5, 0.5)\n",
        "\n",
        "    for w1 in [i/10 for i in range(1,10)]:\n",
        "        w2 = 1 - w1\n",
        "\n",
        "        correct = 0\n",
        "        total = 0\n",
        "\n",
        "        with torch.no_grad():\n",
        "            for images, labels in loader:\n",
        "                images, labels = images.to(device), labels.to(device)\n",
        "\n",
        "                out1 = resnet(images)\n",
        "                out2 = densenet(images)\n",
        "\n",
        "                outputs = (w1 * out1) + (w2 * out2)\n",
        "\n",
        "                _, predicted = torch.max(outputs, 1)\n",
        "                total += labels.size(0)\n",
        "                correct += (predicted == labels).sum().item()\n",
        "\n",
        "        acc = 100 * correct / total\n",
        "        print(f\"Weights ({w1:.1f}, {w2:.1f}) → Accuracy: {acc:.2f}%\")\n",
        "\n",
        "        if acc > best_acc:\n",
        "            best_acc = acc\n",
        "            best_w = (w1, w2)\n",
        "\n",
        "    return best_w, best_acc"
      ],
