      "cell_type": "code",
      "source": [
        "def train_model(model, name):\n",
        "\n",
        "    model = model.to(device)\n",
        "\n",
        "    optimizer = optim.Adam(model.parameters(), lr=0.00005, weight_decay=1e-4)\n",
        "\n",
        "    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
        "        optimizer, mode='max', patience=2, factor=0.3\n",
        "    )\n",
        "\n",
        "    best_val_acc = 0\n",
        "\n",
        "    train_acc_list = []\n",
        "    val_acc_list = []\n",
        "\n",
        "    print(f\"\\n🚀 Training {name}\\n\")\n",
        "\n",
        "    for epoch in range(20):\n",
        "\n",
        "        model.train()\n",
        "        correct = 0\n",
        "        total = 0\n",
        "\n",
        "        for images, labels in train_loader:\n",
        "            images, labels = images.to(device), labels.to(device)\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "\n",
        "            outputs = model(images)\n",
        "            loss = criterion(outputs, labels)   # 🔥 imbalance applied here\n",
        "\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "\n",
        "            _, predicted = torch.max(outputs, 1)\n",
        "            total += labels.size(0)\n",
        "            correct += (predicted == labels).sum().item()\n",
        "\n",
        "        train_acc = 100 * correct / total\n",
        "\n",
        "        val_loss, val_acc = evaluate_full(model, val_loader)\n",
        "\n",
        "        scheduler.step(val_acc)\n",
        "\n",
        "        train_acc_list.append(train_acc)\n",
        "        val_acc_list.append(val_acc)\n",
        "\n",
        "        print(f\"Epoch [{epoch+1}/20]\")\n",
        "        print(f\"Train Acc: {train_acc:.2f}%\")\n",
        "        print(f\"Val Acc  : {val_acc:.2f}%\")\n",
        "        print(\"-\" * 30)\n",
        "\n",
        "        if val_acc > best_val_acc:\n",
        "            best_val_acc = val_acc\n",
        "            torch.save(model.state_dict(), f\"{name}_best.pth\")\n",
        "\n",
        "    # 🔥 Plot Graph\n",
        "    import matplotlib.pyplot as plt\n",
        "\n",
        "    plt.plot(train_acc_list, label=\"Train Accuracy\")\n",
        "    plt.plot(val_acc_list, label=\"Validation Accuracy\")\n",
        "    plt.title(f\"{name} Accuracy Curve\")\n",
        "    plt.xlabel(\"Epoch\")\n",
        "    plt.ylabel(\"Accuracy\")\n",
        "    plt.legend()\n",
        "    plt.show()\n",
        "\n",
        "    print(f\"\\n✅ Best Val Accuracy: {best_val_acc:.2f}%\")\n",
        "\n",
        "    return model"
